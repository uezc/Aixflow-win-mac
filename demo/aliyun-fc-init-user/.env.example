# 复制本文件为 .env 并填写（勿提交 .env 到版本库）
#
# 【多 FC：香港主 + 北京备用】两套函数建议共用「香港」同一 Tablestore：
# OTS_ENDPOINT / OTS_INSTANCE / OTS_TABLE_* / AKSK 与香港 FC 完全一致（香港公网 Endpoint，域名含 cn-hongkong）。
# 北京地域 FC 仅跨区连库，无双表同步；RAM 需有该实例权限。
#
# OTS 终结点须与实例所在地域一致（香港示例；以控制台为准）
OTS_ENDPOINT=https://your-instance.cn-hongkong.ots.aliyuncs.com
# 实例名二选一：OTS_INSTANCE（推荐）或与部分控制台习惯一致的 OTS_INST_NAME
OTS_INSTANCE=your_instance_name
# OTS_INST_NAME=
OTS_ACCESS_KEY_ID=
OTS_ACCESS_KEY_SECRET=
OTS_TABLE_USERS=nx_users
# 兑换码表，主键 code（STRING）；属性 amount_cny、used、used_by_user_id、used_at、created_at
OTS_TABLE_COUPONS=nx_coupons
# 邮箱登录验证码表：主键 email（STRING）；属性 code、expires_at、created_at、send_rate_ts（STRING JSON 发信时间戳，限流）
# OTS_TABLE_VERIFY_CODES=nx_verify_codes
# 发信频率（可选）：默认 60s 内 1 次、1 小时内 5 次（写入 send_rate_ts，多实例 FC 共享）
# NX_SEND_CODE_MIN_MS=60000
# NX_SEND_CODE_HOUR_MS=3600000
# NX_SEND_CODE_PER_HOUR_MAX=5
# Resend 发信（POST /auth/send-code）
# RESEND_API_KEY=re_xxxx
# RESEND_FROM_EMAIL=AIXflow <onboarding@resend.dev>
# 流水表：表名与主键列名须与 Tablestore 控制台一致（常见错误 OTSInvalidPK：Input transaction_id Meta tx_id）
# OTS_TABLE_TRANSACTIONS=transactions
# 若表主键为 tx_id（不是 transaction_id）必须设置：
# OTS_TRANSACTIONS_PK=tx_id
# 充值：人民币→用户余额元宝（与任务扣费倍率分开）
# 任务扣费 + 充值/兑换码（未单独设 NX_YUANBAO_PER_CNY 时充值与此相同）：1 元 = 10 元宝
NX_BILLING_YUANBAO_PER_CNY=10
# 可选：仅覆盖充值汇率；不设则沿用 NX_BILLING_YUANBAO_PER_CNY
# NX_YUANBAO_PER_CNY=10
# 注册新手礼包（元宝，与人民币无关）
# NX_INITIAL_BALANCE=10
# Aixflow 官网管理员：POST /api/admin/*（Header: x-admin-password），含 upload-file、update-json、scan-oss-stock 等
# 与 OSS 同桶（香港）：OSS_REGION=oss-cn-hongkong 等
# FC 与 Bucket 同地域时：OSS_USE_INTERNAL=1 → SDK 使用 https://{OSS_REGION}-internal.aliyuncs.com（香港即 oss-cn-hongkong-internal.aliyuncs.com）
# 可选 OSS_ENDPOINT 覆盖；OSS_PUBLIC_BASE_URL 供回写浏览器可访问的公网 URL
# 若仍报签名/日期相关错误可尝试 V4 签名：OSS_AUTHORIZATION_V4=1（需与 Bucket/地域能力一致）
# 可选：OSS_SHOWCASE_JSON、ADMIN_CORS_ORIGIN
# ADMIN_PASS=
# OSS_USE_INTERNAL=1

# 百炼实时听写（POST /asr/realtime-session；密钥勿下发客户端）
# DASHSCOPE_API_KEY=sk-xxx
# DASHSCOPE_ASR_MODEL=fun-asr-realtime
# DASHSCOPE_WORKSPACE_ID=
# DASHSCOPE_ASR_WS_URL=
# 录音文件识别（POST /asr/file-transcribe；MV 歌词时间线；默认 fun-asr，可钉 fun-asr-2025-11-07）
# DASHSCOPE_ASR_FILE_MODEL=fun-asr
# DASHSCOPE_ASR_FILE_POLL_MS=2500
# DASHSCOPE_ASR_FILE_MAX_WAIT_MS=600000

# 视觉智能 VIAPI 视频人像分割（POST /viapi/segment-video-body；计费键 viapi-segment-video-body，元/分钟；按秒折算 ceil(unit*sec/60)）
# 需开通视频分割服务；RAM 建议 AliyunVIAPIFullAccess。密钥勿下发客户端。
# 官方要求 videoUrl 为上海地域 OSS（或经「文件 URL 处理」转存上海），见文档 155645。
# 智能抠像上传走 POST /upload-media? mediaRegion=sh，须配置上海素材桶：
# OSS_MEDIA_SH_REGION=oss-cn-shanghai
# OSS_MEDIA_SH_BUCKET=nexflow-temp-images-sh
# （桶须已创建且对 OSS_ACCESS_KEY_* 可写；公网可读供 VIAPI 拉取。跨地域写入时勿依赖 OSS_USE_INTERNAL。）
# 北京/香港素材桶（可选覆盖；默认见 lib/upload-media.mjs）：
# OSS_MEDIA_CN_REGION=oss-cn-beijing
# OSS_MEDIA_CN_BUCKET=nexflow-temp-images-bj
# VIAPI_ACCESS_KEY_ID=
# VIAPI_ACCESS_KEY_SECRET=
# ALIBABA_CLOUD_ACCESS_KEY_ID=
# ALIBABA_CLOUD_ACCESS_KEY_SECRET=
# VIAPI_VIDEOSEG_ENDPOINT=https://videoseg.cn-shanghai.aliyuncs.com
# VIAPI_SEGMENT_POLL_MS=4000
# VIAPI_SEGMENT_MAX_WAIT_MS=900000

# 定时结算（POST /internal/settle-stale-tasks）：与 cron 脚本 x-admin-settle-secret 一致
# ADMIN_SETTLE_SECRET=
# 超过该毫秒数未更新的 RUNNING/PROCESSING/PENDING/QUEUED 任务视为超时（默认 1 小时）
# NX_STALE_TASK_MAX_AGE_MS=3600000
