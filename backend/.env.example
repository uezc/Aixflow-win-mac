# 复制本文件为同目录下的 .env（.env 已被 .gitignore 忽略，不会提交 Git）

# cp .env.example .env   或在 Windows: copy .env.example .env



ALIPAY_APP_ID=你的APPID



# PEM 单行填入，换行写 \n（不要提交真实私钥）

ALIPAY_APP_PRIVATE_KEY="-----BEGIN RSA PRIVATE KEY-----\n...\n-----END RSA PRIVATE KEY-----"

ALIPAY_PUBLIC_KEY="-----BEGIN PUBLIC KEY-----\n...\n-----END PUBLIC KEY-----"



# 必须公网 HTTPS；本地联调可用 ngrok / cpolar 暴露 8000 端口

ALIPAY_NOTIFY_URL=https://your-hk-server.example.com/api/v1/alipay/notify

ALIPAY_RETURN_URL=https://your-domain.example.com/pay/success



# 沙箱联调时设为 true

ALIPAY_DEBUG=false



# ---------------------------------------------------------------------------

# FC 入账（notify → nx_orders → rechargeWithLedger）

# 须与 Electron 根目录 .env 及 FC 控制台环境变量一致
# 客户端 ALIPAY_API_BASE 应与本服务公网根 URL 一致（打包进 resources/.env）

# ---------------------------------------------------------------------------

HK_FC_ENDPOINT=https://your-function.cn-hongkong.fcapp.run

# 兼容旧名

# ALIYUN_FC_INIT_USER_URL=



# 与 FC API_SECRET_TOKEN 相同

ALIYUN_FC_TOKEN=



# 支付服务调 FC internal 接口密钥（须与 FC NX_ALIPAY_PAY_SECRET 一致）

# 未设时可回退使用 NX_ADMIN_ISSUE_COUPON_SECRET

NX_ALIPAY_PAY_SECRET=

