# 复制到服务器：/etc/nginx/sites-available/aixflow-alipay
# 将 pay.aixflow.ai 换成你的支付域名；证书路径按 certbot 实际路径修改。
#
#   sudo ln -s /etc/nginx/sites-available/aixflow-alipay /etc/nginx/sites-enabled/
#   sudo nginx -t && sudo systemctl reload nginx

server {
    listen 80;
    server_name pay.aixflow.ai;
    return 301 https://$host$request_uri;
}

server {
    listen 443 ssl http2;
    server_name pay.aixflow.ai;

    ssl_certificate     /etc/letsencrypt/live/pay.aixflow.ai/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/pay.aixflow.ai/privkey.pem;

    client_max_body_size 2m;

    location / {
        proxy_pass http://127.0.0.1:8000;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;

        # SSE：/api/v1/alipay/events/stream（backend 已设 X-Accel-Buffering: no）
        proxy_buffering off;
        proxy_cache off;
        proxy_read_timeout 3600s;
    }
}
