# 服务器 /opt/aixflow/backend/.env 生产模板（勿提交含真实密钥的文件）
# 复制为 .env 后填入真实值；与本地 backend/.env 密钥同源，仅 URL 改为正式域名。

ALIPAY_APP_ID=2021006159656144
ALIPAY_DEBUG=false

# 必须与支付宝开放平台「网关地址」完全一致
ALIPAY_NOTIFY_URL=https://aixflow.com.cn/api/v1/alipay/notify
ALIPAY_RETURN_URL=https://aixflow.com.cn/

ALIPAY_APP_PRIVATE_KEY="-----BEGIN RSA PRIVATE KEY-----\n...\n-----END RSA PRIVATE KEY-----"
ALIPAY_PUBLIC_KEY="-----BEGIN PUBLIC KEY-----\n...\n-----END PUBLIC KEY-----"

HK_FC_ENDPOINT=https://nexflow-api-voswynhbpf.cn-hongkong.fcapp.run
ALIYUN_FC_TOKEN=与FC控制台API_SECRET_TOKEN一致
NX_ALIPAY_PAY_SECRET=与FC控制台NX_ALIPAY_PAY_SECRET一致
