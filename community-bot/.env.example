# 复制为 .env 后填写（或在系统环境变量中设置）
#
# 个人微信推荐路径：桌面 RPA（WECHAT_RPA.md）。
# 下列变量：LLM 口语化回复（可选）+ 遗留 wechat-bot.mjs（企业微信）。

# ---------- LLM 口语化（可选；不配则用 knowledge-base 模板，RPA 照常工作）----------
# 关闭：COMMUNITY_LLM_ENABLED=0
# 超时毫秒（默认 12000）
# COMMUNITY_LLM_TIMEOUT_MS=12000

# 方案 A：本机 Ollama（推荐本地）
# COMMUNITY_LLM_ENABLED=1
# 或设 LLM_PROVIDER=ollama / OLLAMA_BASE_URL
# LLM_PROVIDER=ollama
# OLLAMA_BASE_URL=http://127.0.0.1:11434/v1
# OLLAMA_MODEL=qwen2.5:7b

# 方案 B：阿里云 DashScope（OpenAI 兼容模式）
# DASHSCOPE_API_KEY=
# DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
# DASHSCOPE_MODEL=qwen-plus

# 方案 C：OpenAI 或其它兼容接口
# OPENAI_API_KEY=
# OPENAI_BASE_URL=https://api.openai.com/v1
# OPENAI_MODEL=gpt-4o-mini
# 通用别名：LLM_API_KEY / LLM_BASE_URL / LLM_MODEL

# ---------- 企业微信遗留（非个人微信主路径）----------
# HTTP 服务端口
WECHAT_BOT_PORT=8787

# 企业微信「群机器人」Webhook 的 key（群设置 → 群机器人 → Webhook）
# 用于把欢迎语 / 1·2·3 分流回复发到微信群（非个人微信主路径）
WECOM_WEBHOOK_KEY=

# 可选：企业微信自建应用回调加解密（客户群进群事件）
WECOM_CORP_ID=
WECOM_TOKEN=
WECOM_ENCODING_AES_KEY=

# 可选：保护 /hooks/* （第三方 SCRM / Wechaty 调用时带请求头）
# Header: X-Aixflow-Hook-Secret: <同值>
WECHAT_HOOK_SECRET=
